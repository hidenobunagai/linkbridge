  "cards": [
    {
      "dot": "cyan",
      "title": "通話転送・番号整形 (Core Routing)",
      "items": [
        "標準ダイヤラーからの発信を CallRedirectionService で透過的に傍受",
        "国内番号は 0 始まり、国際番号は 010 形式へ自動変換して楽天リンクへ渡す",
        "緊急通報 (110/119) や USSD・特番・0570 は安全に通常発信へスルー"
      ]
    },
    {
      "dot": "violet",
      "title": "Shizuku 着信完全遮断 (Rootless ADB)",
      "items": [
        "待機中は楽天リンクを suspend して VoLTE キャリア着信を標準電話で受信",
        "発信時は 0.4s 内に自動 unsuspend してシームレスに楽天リンク通話を開始",
        "終話後(3s)および未発信終了時(1.5s)に自動で安全に再 suspend"
      ]
    },
    {
      "dot": "emerald",
      "title": "通話履歴補完 & UI 制御 (Lifecycle)",
      "items": [
        "通話中通知 (notification_call_ongoing) を監視し、実通話のみ正確に履歴記録",
        "発信時に毎回確認オーバーレイ (4秒自動タイムアウト) による柔軟な発信選択",
        "VPN 枠を消費しないため Tailscale やローカル DNS との完全共存を実現"
      ]
    }
  ]
