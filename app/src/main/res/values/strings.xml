<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">LinkBridge</string>
    <string name="subtitle">ダイヤラー発信を楽天リンクへ転送</string>

    <string name="setup_title">セットアップ状況</string>
    <string name="setup_progress">セットアップ %1$d/%2$d 完了</string>
    <string name="badge_optional">任意</string>

    <string name="card_role_title">通話転送アプリ</string>
    <string name="card_role_desc">電話アプリからの発信を楽天リンクへ引き継ぐために必要です。</string>
    <string name="btn_role">デフォルト通話転送アプリに設定</string>

    <string name="card_calllog_title">通話履歴への書き込み</string>
    <string name="card_calllog_desc">転送した通話を履歴に正しく記録するために必要です。</string>
    <string name="btn_calllog">許可する</string>
    <string name="hint_calllog">※ 一部端末では付与できない場合があります。\nadb shell pm grant com.hidenobunagai.linkbridge android.permission.WRITE_CALL_LOG</string>

    <string name="card_overlay_title">画面の上に表示</string>
    <string name="card_overlay_desc">バックグラウンドから楽天リンクを開くために必要です。</string>
    <string name="btn_overlay">許可する</string>
    <string name="hint_overlay">※ 通話転送時に楽天リンクを開くために必要です。</string>

    <string name="card_notif_title">通知へのアクセス</string>
    <string name="card_notif_desc">楽天リンクで実際に発信された通話だけを履歴に記録するために必要です。</string>
    <string name="btn_notif">許可する</string>
    <string name="hint_notif">※ 発信せずに戻った通話 (通知が出ないもの) は履歴に残りません。</string>
    <string name="notif_listener_label">LinkBridge 通話履歴補完</string>

    <string name="status_done">完了</string>
    <string name="status_todo">未設定</string>

    <!-- Shizuku 着信遮断 -->
    <string name="card_shizuku_title">着信の完全遮断 (Shizuku)</string>
    <string name="card_shizuku_desc">楽天リンクを一時停止(suspend)して、着信を標準電話アプリへ強制フォールバックします。Tailscale等のVPNと共存できます。発信時は自動で再開、終話後に再停止します。</string>
    <string name="hint_shizuku_no">Shizukuアプリが見つかりません。https://shizuku.rikka.app からインストールし、adb/ワイヤレスデバッグで起動してください。</string>
    <string name="hint_shizuku_dead">Shizukuサービスが停止しています。Shizukuアプリを開いて「開始」を押してください（再起動後は再実行が必要）。</string>
    <string name="hint_shizuku_perm">Shizukuの権限が必要です。「権限を付与」を押して許可してください。</string>
    <string name="hint_shizuku_rationale">「今後表示しない」で拒否されています。Shizukuアプリ &gt; LinkBridge &gt; 許可 に変更してください。</string>
    <string name="hint_shizuku_ready">準備完了。遮断を有効にすると楽天リンクは停止し、着信は標準電話に届きます。</string>
    <string name="hint_shizuku_active">遮断中: 楽天リンクは停止しています。発信時は自動で再開します。</string>
    <string name="btn_shizuku_perm">権限を付与</string>
    <string name="btn_shizuku_enable">遮断を有効にする</string>
    <string name="btn_shizuku_disable">遮断を無効にする</string>
    <string name="btn_shizuku_temp">一時的に許可 (10分)</string>
    <string name="btn_shizuku_open">Shizukuを開く</string>
    <string name="status_blocked">遮断中</string>
    <string name="status_ready">準備完了</string>
    <string name="status_need_perm">要許可</string>
    <string name="status_no_shizuku">未導入</string>

    <!-- Accessibility: 閉じたら再suspend -->
    <string name="card_a11y_title">閉じたら再遮断 (Accessibility)</string>
    <string name="card_a11y_desc">楽天リンクを発信せずに閉じたときに自動で再停止します。OFFでも通話後の再停止は動作しますが、キャンセル時に開きっぱなしになるのを防ぐにはONがおすすめです。</string>
    <string name="a11y_service_desc">楽天リンクが閉じられたことを検知して、Shizuku遮断を自動で再開するために使用します。画面の内容を読み取ることはありません。</string>
    <string name="hint_a11y_on">有効: 閉じたら1.5秒後に再停止します。</string>
    <string name="hint_a11y_off">無効: 発信キャンセル時に開きっぱなしになります。ONにすると自動で戻ります。</string>
    <string name="btn_a11y">ユーザー補助設定を開く</string>

    <!-- 発信時確認 -->
    <string name="card_confirm_title">発信時に毎回確認</string>
    <string name="card_confirm_desc">発信するたびに「楽天リンク / 通常電話」を選べるようにします。OFF なら従来どおり常に楽天リンクへ転送します。</string>
    <string name="choose_title">発信方法を選択</string>
    <string name="choose_number">発信先: %1$s</string>
    <string name="btn_choose_rakuten">楽天リンクで発信</string>
    <string name="btn_choose_normal">通常の電話で発信</string>
    <string name="choose_hint">何も選択しない場合、15秒後に通常の電話で発信します。</string>
</resources>
